# SalsicciaStagisti — esempio config 12-factor (T04).
# Copia in .env e compila: `copy .env.example .env` (Windows) o `cp .env.example .env`.
# Mai committare .env (ignorato da .gitignore): qui solo chiavi vuote, zero segreti.
# Precedenza: env reali di sistema/Apache vincono su .env (v. env.inc).

# DB cassa — OBBLIGATORI, nessun fallback: se vuoti la cassa si rifiuta
# di partire (HTTP 500, v. dbConnect.php). Copia questo file in .env e compila.
SALSICCIA_DB_HOST=
# DB cassa — nome database, obbligatorio come sopra.
SALSICCIA_DB_NAME=
# DB cassa — utente, obbligatorio come sopra.
SALSICCIA_DB_USER=
# Password DB — obbligatoria come sopra, mai in chiaro nel codice, solo env.
SALSICCIA_DB_PASS=

# Dump fine-giornata fuori docroot — vuoto = storage/dumps alla radice (v. backup.inc).
SALSICCIA_DUMP_DIR=
# Binario mysqldump — vuoto = C:\xampp\mysql\bin\mysqldump.exe poi PATH (v. backup.inc).
SALSICCIA_MYSQLDUMP=

# IP stampante etichette — OBBLIGATORIA, nessun fallback: se vuota la cassa
# si rifiuta di partire (HTTP 500, v. set.inc). Default ZD230 in RETE+ZPL;
# combo permesse: ZD230 (RETE/DIRETTA ZPL), GX420t (DIRETTA ZPL/EPL), TLP2844/LP2844 (DIRETTA EPL).
SALSICCIA_PRINTER_IP=
# Scontrino unico (carta continua) vs biglietti singoli — vuoto = gate printer_is_continuous(), "1"=unico "0"=singoli.
SALSICCIA_CONTINUOUS_LABEL=
# Ora cambio data giornata — fallback 5, intero 0..23 validato in stat_ora_cambio().
SALSICCIA_ORA_CAMBIO=
# Code accesso pannello admin cassa — OBBLIGATORIO come hash Argon2id, mai
# plaintext: se vuoto o non un hash valido la cassa si rifiuta di partire
# (HTTP 500, v. set.inc). Genera con:
# php -r "echo password_hash('CODICE-SCELTO', PASSWORD_ARGON2ID), PHP_EOL;"
# poi incolla l'output qui. T13: SALSICCIA_ADMIN_PWD in chiaro rimossa.
SALSICCIA_ADMIN_PWD_HASH=
# Categoria iniziale cassa — id numerico o nome, vuoto = MIN(id) poi DEFAULT_CAT.
SALSICCIA_DEFAULT_CAT=

# Scontrino fiscale via registratore — vuoto = fiscale disabilitato, la vendita prosegue (v. fiscale.inc).
SALSICCIA_FISCALE_IP=
# Timeout connessione registratore in secondi — default 2 (clamp 1..10).
SALSICCIA_FISCALE_CONNECT_TIMEOUT=
# Timeout totale registratore in secondi — default 9 (clamp 1..30).
SALSICCIA_FISCALE_TIMEOUT=
# Mock senza hardware — "1" scrive l'XML su file invece della rete.
SALSICCIA_FISCALE_MOCK=
# File mock XML — default storage/fiscale_mock.xml (nome file o path assoluto;
# i nomi relativi risolvono in storage/ fuori docroot, mai in public/).
SALSICCIA_FISCALE_MOCK_FILE=
# Coda documenti in attesa di riemissione dopo Fallback — default storage/fiscale_coda.log.
SALSICCIA_FISCALE_QUEUE_FILE=
# Registro documenti fiscali inviati — default storage/fiscale_inviati.log.
SALSICCIA_FISCALE_SENT_FILE=
