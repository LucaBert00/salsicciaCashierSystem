<?xml version="1.0"?>
<!-- T29 PSR-12 sui file nuovi, mai reformat retroattivo sui legacy (rif. docs/ARCHITETTURA_REVISTA.md §7 "Cosa NON fare" e §10 punto 23). -->
<!-- (a) Si normalizza ogni file nuovo (src/config/routes/tests, reserved/auth_password.inc): nasce pulito. I legacy in lista grandfather restano congelati. -->
<!-- (c-d) Warnings (es. riga >120, side-effect) mostrati ma non falliscono per ignore_warnings_on_exit=1; composer cs verde = 0 errori, non 0 warning. Niente reformat di massa per azzerarli. -->
<ruleset name="SalsicciaStagisti-T29">
    <description>PSR-12 sui file nuovi; legacy vivi in lista grandfather, mai ignore silenti; criterio: 0 errori.</description>
    <rule ref="PSR12"/>
    <config name="ignore_warnings_on_exit" value="1"/>
    <arg name="extensions" value="php,inc"/>
    <file>.</file>
    <!-- Tooling e terze parti, mai in scope. -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>.idea/*</exclude-pattern>
    <exclude-pattern>.phpunit.cache/*</exclude-pattern>
    <!-- T29 grandfather (b): solo legacy vivi con ERROR preesistenti; accorciare solo quando un file sparisce, mai per comodita. File nuovi mai esclusi qui: al massimo phpcs:ignore mirato nel file. -->
    <!-- Legacy congelati: dbConnect.php, functionsFrontend.inc, public/index.php, public/reserved/*.php vivi; extensions resta php,inc per functionsFrontend.inc e reserved/auth_password.inc. -->
    <exclude-pattern>dbConnect.php</exclude-pattern>
    <exclude-pattern>functionsFrontend.inc</exclude-pattern>
    <exclude-pattern>public/index.php</exclude-pattern>
    <exclude-pattern>public/reserved/backup.php</exclude-pattern>
    <exclude-pattern>public/reserved/login.php</exclude-pattern>
    <exclude-pattern>public/reserved/stat_pdf.php</exclude-pattern>
    <exclude-pattern>public/reserved/statistiche.php</exclude-pattern>
    <exclude-pattern>public/reserved/visualizza.php</exclude-pattern>
    <exclude-pattern>public/reserved/visualizza_view.php</exclude-pattern>
</ruleset>
